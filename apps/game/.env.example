# Vite embeds this value during the build. Keep one mode-specific file or shell value.
# Development (`vite` / `.env.development.local`):
VITE_API_BASE_URL=http://localhost:3000

# Preview (`vite build --mode preview` / `.env.preview.local`):
# VITE_API_BASE_URL=https://api-preview.example.com

# Production (`vite build` / `.env.production.local`):
# VITE_API_BASE_URL=https://api.example.com
