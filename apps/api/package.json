{
  "name": "@typing-roguelike/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 3000",
    "dev:worker": "wrangler dev --local --port 3000",
    "dev:express": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/worker-dist",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test tests",
    "test:worker": "bun test tests/worker.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply typing-roguelike-local --local"
  },
  "dependencies": {
    "@typing-roguelike/shared": "workspace:*",
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.0",
    "wrangler": "^4.126.0"
  }
}
